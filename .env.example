# Server Configuration
PORT=4101
# Required in all environments. Generate a strong value with: node JWT_SECRET_GENERATOR.js
# JWT_SECRET=
# Optional independent secret. Leave unset to derive a purpose-bound key from JWT_SECRET.
# PASSWORD_RESET_JWT_SECRET=
# Required in production. Leave unset in local development for an ephemeral AdminJS session secret.
# ADMINJS_COOKIE_SECRET=
FRONTEND_URL=http://localhost:4000

# Google OAuth Configuration
# Browser OAuth uses this web client ID, secret, and callback URL.
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:4101/api/auth/google/callback
# Mobile ID-token verification requires only an allowed client ID, never a
# Google client secret. By default the API accepts GOOGLE_CLIENT_ID above.
# For an explicit server-side allow-list (comma-separated), set this instead:
# GOOGLE_ID_TOKEN_AUDIENCES=your_web_client_id.apps.googleusercontent.com,your_ios_or_android_client_id.apps.googleusercontent.com

# OAuth Redirect URLs
OAUTH_SUCCESS_REDIRECT=http://localhost:4000/auth/success
OAUTH_FAILURE_REDIRECT=http://localhost:4000/auth/failed

# Polygon zkEVM Configuration
CONTRACT_ADDRESS=your_contract_address
PRIVATE_KEY=your_polygon_private_key
POLYGON_ZKEVM_RPC=your_rpc_url_here

# Solana Configuration
SOLANA_NETWORK=devnet
SOLANA_PRIVATE_KEY=your_solana_private_key
SOLANA_RPC_URL=https://api.devnet.solana.com

# Pinata Configuration
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET=your_pinata_secret
PINATA_JWT=your_pinata_jwt

# Email Configuration
# Preferred Gmail provider
GMAIL_USER=your_email@example.com
GMAIL_APP_PASSWORD=your_gmail_app_password
# Optional ZeptoMail fallback provider
ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
ZEPTOMAIL_API_KEY=your_zeptomail_api_key
# Legacy configuration used by scheduled jobs
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password

# Flutterwave Configuration
FLW_PUBLIC_KEY=your_flutterwave_public_key
FLW_SECRET_KEY=your_flutterwave_secret_key

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Paystack Configuration
PAYSTACK_PUBLIC_KEY=your_paystack_public_key
PAYSTACK_SECRET_KEY=your_paystack_secret_key

# Stripe Configuration
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# AEKO Chain Configuration
AEKO_RPC_URL=https://rpc.aeko.online
AEKO_EXPLORER_URL=https://api.aeko.online
AEKO_SERVICE_KEYPAIR=your_aeko_service_keypair_json
AEKO_TREASURY_ADDRESS=your_aeko_treasury_address
AEKO_PLATFORM_FEE_BPS=200
SOCIAL_POSTS_STATE_ACCOUNT=your_social_posts_state_account
SOCIAL_REWARDS_STATE_ACCOUNT=your_social_rewards_state_account
REWARD_VAULT_ACCOUNT=your_reward_vault_account
SOCIAL_STAKING_STATE_ACCOUNT=your_social_staking_state_account
STAKING_COOLDOWN_EPOCHS=7

# AEKO Wallet Configuration
AEKO_WALLET_ADMIN_FEE_PERCENTAGE=5

# App Settings
DEFAULT_CURRENCY=USD
PAYMENT_METHODS=paystack,stripe,aeko_wallet

# --- Custodial wallet -------------------------------------------------------
# Master secret from which every user's chain key is derived (HKDF-SHA512).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Store in the platform secret manager. Rotating this changes every derived
# address and strands funds at the old ones, so treat it as permanent.
AEKO_CUSTODY_MASTER_SEED=
# Optional: enables Expo push security so only holders can send to your project.
EXPO_ACCESS_TOKEN=
